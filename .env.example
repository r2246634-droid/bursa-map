# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun (.env.local git'e girmez).

# Koordinattan adres (reverse geocoding) servisi — Nominatim uyumlu bir /reverse uç noktası.
# Boş bırakılırsa OSM'nin ücretsiz sunucusu kullanılır: saniyede en fazla 1 istek ve toplu
# kullanım yasağı olduğundan YAYINDA KULLANILMAMALI. Seçenekler:
#   - Kendi Nominatim sunucunuz:   https://nominatim.sizin-alaniniz.com/reverse
#   - Nominatim uyumlu ücretli servis (anahtar adrese yazılabilir):
#                                  https://saglayici.example.com/v1/reverse?key=ANAHTAR
# Not: NEXT_PUBLIC_ ile başladığı için tarayıcıya gömülür; anahtarınızı sağlayıcı panelinden
# alan adınızla (HTTP referrer) sınırlandırın.
NEXT_PUBLIC_REVERSE_GEOCODE_URL=


# Adresten koordinat (forward geocoding) servisi — Photon uyumlu bir /api uç noktası.
# Boş bırakılırsa komoot'un ücretsiz Photon sunucusu (https://photon.komoot.io/api/) kullanılır:
# anahtar istemez ama "adil kullanım" sınırı vardır; yoğun trafikte kendi Photon sunucunuzu kurun.
NEXT_PUBLIC_GEOCODE_URL=
