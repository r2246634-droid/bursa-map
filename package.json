{
  "name": "bursa-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/split-shapes.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/split-shapes.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "data:bursaray": "node scripts/fetch-bursaray.mjs",
    "data": "npm run data:pois && npm run data:amenities && npm run data:bursaray && npm run data:rail-gaps",
    "data:pois": "node scripts/fetch-pois.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "data:shapes": "node scripts/split-shapes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:rail-gaps": "node scripts/patch-rail-gaps.mjs",
    "data:walk": "node --max-old-space-size=2048 scripts/fetch-walk-graph.mjs",
    "data:amenities": "node scripts/fetch-amenities.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
